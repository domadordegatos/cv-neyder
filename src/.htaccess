#
# Configuración de Apache para el sitio desplegado.
#
# Este archivo vive en el repositorio y se copia a dist/base/ en cada build
# (está declarado como asset en angular.json). Antes existía solo en el
# servidor, y un despliegue con `rsync --delete` lo borró: las rutas de Angular
# empezaron a dar 404 y el sitio quedó caído hasta que se restauró a mano.
# Versionarlo evita que eso dependa de que quien despliega se acuerde.
#
# Si se cambia algo acá, se cambia en el repositorio, no en el servidor: el
# próximo build sobrescribe lo que haya en destino.
#

Options -MultiViews
RewriteEngine On

# Solo se reescribe a index.html lo que no corresponde a un archivo (!-f) ni a
# un directorio (!-d) real en disco. Sin el !-d, una carpeta que exista de
# verdad en el docroot —hoy solo assets/— se tragaba la reescritura en vez de
# servirse como lo que es.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

<Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

<FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
</FilesMatch>

<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
