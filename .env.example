# Copia este archivo a .env y rellena la clave. El .env esta ignorado por git.
#
#   cp .env.example .env
#
# scripts/set-env.js lee estos valores en cada build y genera
# src/environments/environment.ts y environment.prod.ts.
#
# En CI estos valores van como secrets del repositorio, no en un archivo.

# URL base de la API de nncoms.
API_URL=https://api.nncoms.com

# Clave que se envia en el header X-API-Key. Pidela al dueno del backend.
# Sin ella el sitio compila, pero las secciones que leen de la API saldran vacias.
API_KEY=

# Nombre de la base de datos en Mongo.
API_DB=cvneyder
